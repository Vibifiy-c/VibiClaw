{
  "name": "vibi-ai",
  "version": "1.0.0",
  "description": "Vibi AI Desktop App",
  "author": "Spooky <spooky@example.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.vibify.vibi-ai",
    "productName": "Vibi AI",
    "publish": null,
    "asarUnpack": [
      "app.py"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    },
    "files": [
      "main.js",
      "preload.js",
      "front_end_ui.html",
      "app.py"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}